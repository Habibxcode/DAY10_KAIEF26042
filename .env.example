# OpenAI API Key (optional)
# All three scripts run in offline/fallback mode without this key.
# When set, enables live GPT-4o-mini calls in secure_rag.py and autogen_team.py.
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here
